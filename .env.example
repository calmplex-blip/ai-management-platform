# ConsciousOps Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# Application Configuration
# =============================================================================

# Application URL (for production deployments)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, staging, production)
NODE_ENV=development

# =============================================================================
# API Configuration (Optional - for backend integration)
# =============================================================================

# Backend API endpoint
# NEXT_PUBLIC_API_URL=https://api.yourcompany.com

# API authentication token
# API_AUTH_TOKEN=your-secret-token-here

# =============================================================================
# MCP Server Configuration (Optional defaults)
# =============================================================================

# Default MCP server URL (if you have a central MCP server)
# NEXT_PUBLIC_DEFAULT_MCP_SERVER=http://localhost:8080

# MCP connection timeout (milliseconds)
# NEXT_PUBLIC_MCP_TIMEOUT=30000

# =============================================================================
# Authentication (Optional - for future implementation)
# =============================================================================

# Authentication provider (auth0, cognito, custom)
# NEXT_PUBLIC_AUTH_PROVIDER=custom

# Auth0 configuration
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret

# JWT secret for session management
# JWT_SECRET=your-super-secret-jwt-key-change-this

# =============================================================================
# Database (Optional - for future implementation)
# =============================================================================

# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/consciousops

# Redis for caching/sessions
# REDIS_URL=redis://localhost:6379

# =============================================================================
# External Services (Optional)
# =============================================================================

# OpenAI API key (if using OpenAI models)
# OPENAI_API_KEY=sk-...

# Anthropic API key (if using Claude models)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Cloud API key (for A2A/AP2 integration)
# GOOGLE_CLOUD_API_KEY=your-api-key

# =============================================================================
# Monitoring & Analytics (Optional)
# =============================================================================

# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# =============================================================================
# Feature Flags (Optional)
# =============================================================================

# Enable experimental features
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL=false

# Enable debug mode
# NEXT_PUBLIC_DEBUG=false

# =============================================================================
# Email Configuration (Optional - for notifications)
# =============================================================================

# SMTP server configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourcompany.com

# =============================================================================
# Storage (Optional - for file uploads)
# =============================================================================

# AWS S3 configuration
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name

# =============================================================================
# Rate Limiting (Optional - for production)
# =============================================================================

# Rate limit per IP (requests per minute)
# RATE_LIMIT_RPM=100

# =============================================================================
# CORS Configuration (Optional - for production)
# =============================================================================

# Allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://yourcompany.com,https://app.yourcompany.com

# =============================================================================
# Logging (Optional)
# =============================================================================

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# =============================================================================
# Development Tools
# =============================================================================

# Playwright test configuration
# PLAYWRIGHT_HEADLESS=true
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# =============================================================================
# Notes
# =============================================================================

# For local development:
# 1. Copy this file to .env.local
# 2. Fill in required values
# 3. Never commit .env.local to git
#
# For production deployment:
# 1. Set these as environment variables in your hosting platform
# 2. Use secrets management for sensitive values
# 3. Enable all security features
#
# See docs/API-INTEGRATION.md for detailed configuration guide
